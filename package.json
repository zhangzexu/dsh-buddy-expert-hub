{
  "name": "dsh-buddy-expert-hub",
  "version": "1.0.3",
  "description": "DeepSeek Harness 插件：专家 / 专家团 / 技能 / 连接器 浏览、检索与导入面板",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangzexu/dsh-buddy-expert-hub.git"
  },
  "homepage": "https://github.com/zhangzexu/dsh-buddy-expert-hub#readme",
  "bugs": {
    "url": "https://github.com/zhangzexu/dsh-buddy-expert-hub/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-buddy-expert-hub",
    "skills",
    "connectors"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "builtin/**/skills/**",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "assets"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:connectors": "node scripts/build-connectors.mjs",
    "build:market": "node scripts/build-market-index.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/csv.js && node --check lib/workbench-menu.js && node --check lib/workbench.js && node --check lib/workbench-bridge.js && node --check lib/plugin-update.js && node --check lib/frontmatter.js && node --check lib/connector-meta.js && node --check lib/connector-provision.js && node --check lib/connector-secret.js && node --check lib/connector-store.js && node scripts/check-package.mjs",
    "check:package": "node scripts/check-package.mjs --verbose"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
